# Build output - regenerate with build.bat / build-test.bat / build-demo.bat
*.exe
*.obj
*.pdb
*.ilk
*.exp
*.lib

# Linker-generated side-by-side manifest. GpuToolbox.manifest is hand-written
# source and must stay tracked - it is what makes the app require admin.
*.exe.manifest

# Compiled resource output (GpuToolbox.rc and .ico stay tracked).
*.res

# Packaged output from dist.bat - rebuildable, and the shortcut inside embeds
# absolute paths from the machine that produced it.
dist/

# MSVC incremental build artifacts
*.idb
*.iobj
*.ipdb
vc140.pdb

# Editor / OS noise
.vs/
*.user
*.suo
Thumbs.db
desktop.ini
